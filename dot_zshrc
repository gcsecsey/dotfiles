# WordPress.com sync functions
function wppull() {
  rsync -az --delete --delete-after --info=progress2 --exclude '.config' --exclude '.svn' --exclude '.git' --exclude '.settings' --exclude 'wp-content/themes' --exclude 'wp-content/languages' --exclude '*.png' --exclude '*.jpeg' --exclude '*.jpg' --exclude '*.gif' --exclude '*.mp3' --exclude '*.mov' --exclude '*.wav' --exclude '*.tiff' wpcom-sandbox:/home/wpcom/public_html/ ~/a8c-projects/wpcom/
}

function wppush() {
  rsync -az --delete --delete-after --info=progress2 --exclude '.config' --exclude '.svn' --exclude '.git' --exclude '.settings' --exclude 'wp-content/themes' --exclude 'wp-content/languages' --exclude '*.png' --exclude '*.jpeg' --exclude '*.jpg' --exclude '*.gif' --exclude '*.mp3' --exclude '*.mov' --exclude '*.wav' --exclude '*.tiff' ~/a8c-projects/wpcom/ wpcom-sandbox:/home/wpcom/public_html/
}

function wpautopush() {
  # path to your local copy of public_html folder
  WORKDIR=~/a8c-projects/wpcom/

  echo "Watching changes on $WORKDIR"

  current_OS=$(uname)

  # For macOS (Darwin) is needed fsevents-tools installed (you can use homebrew install fsevents-tools)
  if [ $current_OS == "Darwin" ]; then
    echo
    notifyloop $WORKDIR wppush
  else
    while inotifywait -qqr $WORKDIR -e create,move,modify,delete; do
      echo
      echo 'Change detected, pushing'
      wppush
    done
  fi
}

